<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- Avisos visuales (antena, GPS, batería, stint): solo visible mientras dura el problema -->
        <TextView
            android:id="@+id/alertStrip"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginBottom="6dp"
            android:background="#EF4444"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Vista 1: completa -->
            <LinearLayout
                android:id="@+id/viewMain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- Tarjeta del delta (protagonista, 60% del ancho) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="6"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="DELTA"
                        android:textColor="#9AA3AE"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDelta"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center_vertical|start"
                        android:maxLines="1"
                        android:text="—.—"
                        android:textColor="#C6F432"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="160sp"
                        app:autoSizeMinTextSize="40sp"
                        app:autoSizeStepGranularity="2sp"
                        app:autoSizeTextType="uniform" />

                    <com.ejemplo.laptimer.DeltaBarView
                        android:id="@+id/deltaBar"
                        android:layout_width="match_parent"
                        android:layout_height="24dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtRangeNeg"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="-2 %"
                            android:textColor="#9AA3AE"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:id="@+id/txtRangeLabel"
                            android:text="±2 % BEST LAP"
                            android:textColor="#9AA3AE"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtRangePos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="+2 %"
                            android:textColor="#9AA3AE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Columna derecha (40% del ancho) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="4"
                    android:orientation="vertical">

                    <!-- Tiempo de vuelta + sectores F1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1.25"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtLapLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-condensed"
                                android:letterSpacing="0.06"
                                android:text="LAP 1"
                                android:textColor="#F2F4F7"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtSpeedCorner"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:text="0 km/h"
                                android:textColor="#7B8590"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progLaps"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="4dp"
                            android:max="1000"
                            android:progress="0"
                            android:progressBackgroundTint="#2A3139"
                            android:progressTint="#C6F432"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/txtLap"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-condensed"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:text="--:--.---"
                            android:textColor="#F2F4F7"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="130sp"
                            app:autoSizeMinTextSize="20sp"
                            app:autoSizeStepGranularity="2sp"
                            app:autoSizeTextType="uniform" />

                        <LinearLayout
                            android:id="@+id/chipsRow"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <!-- BEST / LAST / OPTIMAL: tres filas anchas para que los tiempos se lean grandes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1.15"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="86dp"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.08"
                                android:text="BEST"
                                android:textColor="#9AA3AE"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtBest"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-condensed"
                                android:gravity="center_vertical|end"
                                android:maxLines="1"
                                android:text="--:--.---"
                                android:textColor="#C6F432"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="64sp"
                                app:autoSizeMinTextSize="14sp"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeTextType="uniform" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                        android:layout_marginTop="2dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="86dp"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.08"
                                android:text="LAST"
                                android:textColor="#9AA3AE"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtLast"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-condensed"
                                android:gravity="center_vertical|end"
                                android:maxLines="1"
                                android:text="--:--.---"
                                android:textColor="#F2F4F7"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="64sp"
                                app:autoSizeMinTextSize="14sp"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeTextType="uniform" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                        android:layout_marginTop="2dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="86dp"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.08"
                                android:text="OPTIMAL"
                                android:textColor="#9AA3AE"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtOpt"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-condensed"
                                android:gravity="center_vertical|end"
                                android:maxLines="1"
                                android:text="--:--.---"
                                android:textColor="#F2F4F7"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="64sp"
                                app:autoSizeMinTextSize="14sp"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeTextType="uniform" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Stint (piloto, tiempo, vueltas) y velocidad pequeña -->
                    <LinearLayout
                        android:id="@+id/stintBar"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/card_bg"
                        android:gravity="center_vertical|end"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/txtStint"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-condensed"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:text="STINT 1"
                            android:textColor="#9AA3AE"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="16sp"
                            app:autoSizeMinTextSize="9sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:id="@+id/txtSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-condensed"
                            android:text="0"
                            android:textColor="#7B8590"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="km/h"
                            android:textColor="#6B7480"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Vista 2: simplificada (delta + sectores F1) -->
            <LinearLayout
                android:id="@+id/viewSimple"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="DELTA"
                        android:textColor="#9AA3AE"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDelta2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="—.—"
                        android:textColor="#C6F432"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="260sp"
                        app:autoSizeMinTextSize="40sp"
                        app:autoSizeStepGranularity="2sp"
                        app:autoSizeTextType="uniform" />

                    <com.ejemplo.laptimer.DeltaBarView
                        android:id="@+id/deltaBar2"
                        android:layout_width="match_parent"
                        android:layout_height="28dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chipsRow2"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />
            </LinearLayout>
                    <!-- Vista 3: mapa del circuito con tu posición -->
            <FrameLayout
                android:id="@+id/viewMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <com.ejemplo.laptimer.TrackMapView
                    android:id="@+id/trackMap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/txtDelta3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="14dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="—.—"
                    android:textColor="#C6F432"
                    android:textSize="54sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtLap3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="14dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="--:--.---"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtInfo3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="14dp"
                    android:layout_marginBottom="52dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="LAP 1"
                    android:textColor="#F2F4F7"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStint3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="52dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text=""
                    android:textColor="#F2F4F7"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/chipsRow3"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal" />
            </FrameLayout>

            <!-- Vista 4: Diagnóstico GPS y Velocidad Detallada -->
            <LinearLayout
                android:id="@+id/viewGpsSpeed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0B0D10"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS &amp; SPEED TELEMETRY"
                    android:textColor="#9AA3AE"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/txtGpsSpeedBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="0"
                    android:textColor="#C6F432"
                    android:textSize="96sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KM/H"
                    android:textColor="#F2F4F7"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#15181C"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:elevation="4dp">

                    <TextView
                        android:id="@+id/txtGpsDetailFreq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refresh Rate: -- Hz"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:id="@+id/txtGpsDetailSats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Satellites: -- · HDOP: --"
                        android:textColor="#F2F4F7"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:id="@+id/txtGpsDetailAlt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Altitude: -- m · Fix: Active"
                        android:textColor="#9AA3AE"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Banda inferior: solo visible con un mensaje del pit o durante el reconocimiento -->
        <FrameLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/bannerPit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text=""
                android:textColor="#141413"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/reconBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnMarkFinish"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="MARCAR FINISH"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnMarkSector"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="MARCAR SECTOR"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="GUARDAR"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="CANCELAR"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Petición de cambio de piloto del pit: se confirma en boxes -->
            <LinearLayout
                android:id="@+id/swapBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/banner_swap"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtSwap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="PIT PIDE CAMBIO DE DRIVER"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSwapConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:text="CONFIRMAR CAMBIO"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Resumen al cruzar la meta: tiempo, delta final y número de vuelta (y stint en resistencia) -->
    <LinearLayout
        android:id="@+id/lapOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20B0D10"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtSumTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="LAP 1"
            android:textColor="#9AA3AE"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSumTime"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:maxLines="1"
            android:text="--:--.---"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="240sp"
            app:autoSizeMinTextSize="30sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/txtSumDelta"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:maxLines="1"
            android:text="—.—"
            android:textColor="#C6F432"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="110sp"
            app:autoSizeMinTextSize="24sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform" />

        <LinearLayout
            android:id="@+id/chipsRowSum"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/txtSumStint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:maxLines="1"
            android:text=""
            android:textColor="#9AA3AE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Pantalla de boxes: encima de todo, fondo amarillo parpadeante con cuenta atrás -->
    <LinearLayout
        android:id="@+id/pitOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFE23A"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtPitTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="PIT"
            android:textColor="#0B0D10"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPitCount"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:maxLines="1"
            android:text="PIT"
            android:textColor="#0B0D10"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="190sp"
            app:autoSizeMinTextSize="40sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/txtPitSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#0B0D10"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/pitSwapBox"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/banner_swap"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtPitSwap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="CAMBIO DE DRIVER"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPitSwapConfirm"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:text="CONFIRMAR CAMBIO"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Barra superior oculta: aparece deslizando desde arriba, se esconde sola a los 5 s -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#F00B0D10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtTop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sin circuito"
            android:textColor="#9AA3AE"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHome"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="INICIO"
            android:textColor="#C6F432"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtNet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="PIT: desactivado"
            android:textColor="#9AA3AE"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="GPS sin señal"
            android:textColor="#9AA3AE"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
