<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LapTimer" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0B0D10</item>
        <item name="android:statusBarColor">#0B0D10</item>
        <item name="android:navigationBarColor">#0B0D10</item>
        <item name="colorPrimary">#C6F432</item>
        <item name="colorAccent">#C6F432</item>
        <item name="alertDialogTheme">@style/Theme.LapTimer.Dialog</item>
    </style>

    <!-- Ventanas de confirmación con el estilo de la app -->
    <style name="Theme.LapTimer.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#F2F4F7</item>
        <item name="android:textColorSecondary">#9AA3AE</item>
        <item name="colorAccent">#C6F432</item>
        <item name="colorPrimary">#C6F432</item>
    </style>
</resources>
