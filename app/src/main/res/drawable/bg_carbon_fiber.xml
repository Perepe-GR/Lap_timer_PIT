<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Deep Charcoal Matrix -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0C10" />
        </shape>
    </item>
    <!-- Diagonal Carbon Grain 1 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:centerX="0.3"
                android:centerY="0.3"
                android:endColor="#161B22"
                android:startColor="#1F242D"
                android:type="linear" />
        </shape>
    </item>
    <!-- Forged Carbon Flake Patches -->
    <item android:top="10dp" android:left="5dp" android:right="20dp" android:bottom="30dp">
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#2D333B" android:endColor="#12161E" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:top="40dp" android:left="30dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <gradient android:angle="30" android:startColor="#3A414B" android:endColor="#0F1217" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item android:top="20dp" android:left="50dp" android:right="5dp" android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient android:angle="75" android:startColor="#222831" android:endColor="#181D23" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
